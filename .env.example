# Copier vers apps/api/.env pour le developpement local.
# Les identifiants ci-dessous correspondent au docker-compose.yml du depot.

DATABASE_URL="postgresql://passerelle:passerelle@localhost:5434/passerelle?schema=public"
REDIS_URL="redis://localhost:6380"

# Base des tests d'integration. Elle est creee et migree automatiquement au
# premier `pnpm test`, et videe a chaque suite : ne jamais la faire pointer sur
# une base qui contient quoi que ce soit d'utile.
DATABASE_URL_TEST="postgresql://passerelle:passerelle@localhost:5434/passerelle_test?schema=public"

# API
API_PORT=3001
API_CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="a-remplacer-en-production"
JWT_EXPIRES_IN="15m"
# Duree de la session revocable : une journee de travail.
REFRESH_EXPIRES_SECONDS=43200

# Agence a laquelle rattacher les inscriptions venues du site public. Facultatif :
# un deploiement mono-agence prend la seule qui existe. A renseigner des que le
# groupe en exploite plusieurs, sinon les inscriptions tombent toutes sur la
# plus ancienne.
AGENCE_PAR_DEFAUT_ID=""

# Front : adresse de l'API vue par Nitro. Volontairement non publique, le
# navigateur ne parle jamais directement a l'API (relais /bff).
NUXT_API_BASE="http://localhost:3001/api"

# Geocodage des adresses par la Base Adresse Nationale. Service public,
# gratuit, sans cle : il n'y a rien a renseigner pour qu'il fonctionne. Les
# deux variables ne servent qu'a le couper (suites d'integration, poste hors
# reseau) ou a le faire pointer sur un miroir.
GEOCODAGE_ACTIF="true"
BAN_URL="https://api-adresse.data.gouv.fr/search/"

# API France Travail (offres d emploi) : creer une application sur
# francetravail.io, souscrire a l API "Offres d emploi v2", et reporter ici les
# deux valeurs. Sans elles, l import ne fonctionne qu a partir d un instantane
# local (option --fichier).
FRANCE_TRAVAIL_CLIENT_ID=""
FRANCE_TRAVAIL_CLIENT_SECRET=""

# Balayage automatique des offres, deux fois par jour (5 h et 13 h).
#
# A mettre a "true" sur le serveur qui sert le site, et sur lui seul. La licence
# de reutilisation de la base d'offres France Travail impose d'interroger l'API
# au moins toutes les 24 heures, pour que les creations, modifications et
# suppressions se repercutent ici : republier des offres sans ce balayage
# afficherait indefiniment des missions deja pourvues.
#
# Laisse a "false" sur les postes de developpement : sinon chaque machine tape
# l'API pour son propre compte, et plusieurs imports concurrents vers la meme
# base de recette se marchent dessus.
IMPORT_OFFRES_AUTOMATIQUE="false"

# Envoi des mails. En developpement, le docker-compose fournit Mailpit : rien a
# changer, et la boite de reception s'ouvre sur http://localhost:8025. En
# production, pointer ces variables sur un vrai relais SMTP.
MAIL_HOST="localhost"
MAIL_PORT=1025
# Vides en local : Mailpit accepte tout. Obligatoires en production.
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="Releve <ne-pas-repondre@releve.example>"

# Base des liens envoyes par mail. C'est l'adresse du *front*, pas de l'API :
# la personne clique dans son navigateur et atterrit sur une page Nuxt.
APP_URL="http://localhost:3000"
# Duree de validite d'un lien de verification d'adresse.
VERIFICATION_EXPIRE_HEURES=48
# Duree de validite d un lien de reinitialisation de mot de passe. Bien plus
# courte que la confirmation d adresse : ce lien-ci ouvre un compte existant.
REINITIALISATION_EXPIRE_HEURES=1

# Racine de stockage des pieces justificatives. Le dossier est cree au premier
# depot. Il contient des donnees personnelles sensibles : le placer hors du
# depot en production, sur un volume sauvegarde et chiffre au repos.
STOCKAGE_DOCUMENTS="./donnees/documents"

# Automatisations (n8n). L'API emet des webhooks signes vers n8n a chaque
# transition de mission, et n8n la rappelle sur /api/interne/* avec un jeton de
# service. Les deux secrets se generent localement : openssl rand -hex 32
#
# Tant que l'URL ou le secret manquent, l'API se tait : les transitions sont
# ecrites dans le journal EvenementMission, mais rien ne sort. C'est l'etat
# normal d'un poste de developpement qui ne fait pas tourner n8n.
N8N_EVENTS_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""

# Secret des routes /api/interne/*. Sans lui elles repondent 503 : un oubli de
# configuration ferme la porte, il ne l'ouvre pas.
INTERNAL_SERVICE_TOKEN=""

# Seuil de relance des missions non pourvues, en minutes. Lu par le workflow
# n8n, pas par l'API : c'est lui qui le passe en parametre de
# /api/interne/missions/non-pourvues. 1440 = une journee ; 1 pour une demonstration.
RELANCE_SEUIL_MIN=1440
