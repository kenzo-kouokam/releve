        "subject": "={{ $('Webhook').first().json.body.event === 'mission.pourvue' ? 'Mission pourvue' : 'Mission annulée' }} – {{ $('Webhook').first().json.body.mission.qualification }} à {{ $('Webhook').first().json.body.mission.commune }}",
        "emailFormat": "html",
        "html": "={{ (() => {\n  const m = $('Webhook').first().json.body.mission;\n  const pourvue = $('Webhook').first().json.body.event === 'mission.pourvue';\n  const date = new Date(m.dateDebut).toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });\n  return `<p>Bonjour ${$json.prenom},</p>\n<p>La mission <strong>${m.qualification}</strong> à <strong>${m.commune}</strong> du ${date} (${m.heureDebut}–${m.heureFin}) ${pourvue ? 'a été pourvue par un autre intervenant' : \"a été annulée par l'établissement\"}.</p>\n<p>Votre candidature est donc close. Merci pour votre réactivité : d'autres missions vous attendent sur Relève.</p>\n<p><a href=\"http://localhost:3000/missions\">Voir les missions disponibles</a></p>\n<p>L'équipe Relève</p>`;\n})() }}",
